    "num =int(input(\"enter a number:\"))\n",
    "if num > 1:\n",
    "    for i in range(2 ,num):\n",
    "        if num%i==0:\n",
    "            print(\"not prime\")\n",
    "            break\n",
    "            \n",
    "    else:\n",
    "           print(\"prime\")\n",
    "\n",
    "else:\n",
    "    print(\"prime\")"
